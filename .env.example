# Copy this file to .env for local development. Never commit .env.
NODE_ENV=development
PORT=3000

APP_BASE_URL=http://localhost:3000
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters-long

# Auth0 Dashboard -> Applications -> your Regular Web Application
OIDC_ISSUER=https://YOUR_AUTH0_TENANT.us.auth0.com/
OIDC_CLIENT_ID=your-auth0-client-id
OIDC_CLIENT_SECRET=your-auth0-client-secret
OIDC_REDIRECT_URI=http://localhost:3000/auth/callback
OIDC_SCOPE=openid profile email

# Firebase Admin access. This must point to the SAME project used by the docs app.
FIRESTORE_ENABLED=true
FIRESTORE_PROJECT_ID=ftcdocumentation-53b62
FIRESTORE_USERS_COLLECTION=identityProfiles
FIRESTORE_TEAM_USERS_COLLECTION=users
FIRESTORE_SESSIONS_COLLECTION=identitySessions
FIRESTORE_OAUTH_CODES_COLLECTION=identityOAuthCodes
# Local development: path to a service-account JSON file outside the public repo.
# Production: use the hosting provider's attached service account / ADC instead.

# Central sign-in integration with the documentation app.
DOCS_OAUTH_CLIENT_ID=ftc30458-documentation
DOCS_ORIGIN=https://log.ftc30458.com
DOCS_REDIRECT_URI=https://log.ftc30458.com/auth-callback.html
