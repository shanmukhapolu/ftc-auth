# Copy this file to .env for local development. Never commit .env.
NODE_ENV=development
PORT=3000

# Set to 1 when running behind one trusted reverse proxy (e.g. GitHub Codespaces).
TRUST_PROXY=0

APP_BASE_URL=http://localhost:3000
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters-long

# Auth0 Dashboard -> Applications -> your Regular Web Application
OIDC_ISSUER=https://YOUR_AUTH0_TENANT.us.auth0.com/
OIDC_CLIENT_ID=your-auth0-client-id
OIDC_CLIENT_SECRET=your-auth0-client-secret
OIDC_REDIRECT_URI=http://localhost:3000/auth/callback
OIDC_SCOPE=openid profile email

# Optional profile metadata storage. Keep disabled until Firebase Admin credentials are configured.
FIRESTORE_ENABLED=false
FIRESTORE_PROJECT_ID=your-firebase-project-id
FIRESTORE_USERS_COLLECTION=identityProfiles
